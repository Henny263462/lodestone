# Zugang des ersten Administrators (wird nur beim allerersten Start angelegt)
LODESTONE_ADMIN_USER=admin
LODESTONE_ADMIN_PASSWORD=
# Gemeinsames Geheimnis zwischen Panel und Node, mindestens 24 Zeichen:  openssl rand -hex 32
LODESTONE_NODE_TOKEN=
# Adresse, unter der Spieler die Maschine erreichen (für Beitritts-Adresse und Voicechat)
LODESTONE_PUBLIC_HOST=
# Port der Weboberfläche auf der Maschine
LODESTONE_PANEL_PORT=8480
# Ordner auf der Maschine für alle Serverdaten (muss existieren, Besitzer 1000:1000)
LODESTONE_DATA=/srv/lodestone
# Port für SFTP (FileZilla, WinSCP) auf der Maschine; die Zugänge verwaltet das Panel
LODESTONE_SFTP_PORT=2022
# Weitere Nodes auf anderen Maschinen fügst du im Panel unter Nodes hinzu. Sie verbinden sich selbst zum Panel und bekommen
# dafür LODESTONE_NODE_PANEL_URL und LODESTONE_NODE_JOIN_TOKEN (der fertige Befehl steht im Panel).
# Bereich, aus dem Server-Ports vergeben werden
LODESTONE_PORT_RANGE=25565-25999
# Gruppe des Docker-Sockets:  stat -c %g /var/run/docker.sock
DOCKER_GID=999
# Hinter HTTPS-Proxy auf true setzen
LODESTONE_SECURE_COOKIES=false
LODESTONE_TRUST_PROXY=false
# Adresse des Panels im Browser (für Passkeys und die Anmeldung über OIDC), z. B. https://panel.example.org
LODESTONE_PUBLIC_URL=
# Anmeldung über einen OIDC-Anbieter (Authentik, Keycloak, Authelia, Google ...); leer = aus
# Rücksprungadresse beim Anbieter: <LODESTONE_PUBLIC_URL>/api/auth/oidc/callback
LODESTONE_OIDC_ISSUER=
LODESTONE_OIDC_CLIENT_ID=
LODESTONE_OIDC_CLIENT_SECRET=
LODESTONE_OIDC_NAME=
LODESTONE_OIDC_AUTO_CREATE=false
LODESTONE_OIDC_ADMIN_GROUP=
# true schaltet die Anmeldung mit Passwort ab (Notfall: wieder auf false setzen und neu starten)
LODESTONE_OIDC_ONLY=false
# Token für Prometheus (GET /metrics mit Authorization: Bearer …); leer = abgeschaltet:  openssl rand -hex 24
LODESTONE_METRICS_TOKEN=
# Optional: API-Schlüssel von console.curseforge.com, schaltet CurseForge als Quelle für Mods frei
LODESTONE_CURSEFORGE_KEY=
