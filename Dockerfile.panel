# Baut Oberfläche und Panel komplett im Container (für alle, die Lodestone selbst bauen wollen).
# Web- und Go-Stufe laufen immer auf der Plattform des Builders und kompilieren das Go-Binary für die Zielplattform
# (Cross-Compile). So braucht ein arm64-Image keine QEMU-Emulation für npm und go build.
FROM --platform=$BUILDPLATFORM node:22-alpine AS web
WORKDIR /src/web
ENV NEXT_TELEMETRY_DISABLED=1
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund
COPY web/ ./
RUN --mount=type=cache,target=/src/web/.next/cache \
    npx next build

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS
ARG TARGETARCH
# Release-Version für die Update-Prüfung; ohne Angabe meldet sich das Binary als „dev“ und gilt nie als veraltet.
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN rm -rf internal/panel/webui/dist
COPY --from=web /src/web/out internal/panel/webui/dist
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/lodestone-panel ./cmd/lodestone-panel

FROM alpine:3.24
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 1000 lodestone && mkdir /data && chown lodestone /data
COPY --from=build /out/lodestone-panel /usr/local/bin/lodestone-panel
USER lodestone
ENV LODESTONE_DATA_DIR=/data LODESTONE_LISTEN=:8480
VOLUME /data
EXPOSE 8480
ENTRYPOINT ["lodestone-panel"]
