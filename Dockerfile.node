# Die Go-Stufe läuft immer auf der Plattform des Builders und kompiliert für die Zielplattform (Cross-Compile),
# damit ein arm64-Image keine QEMU-Emulation für go build braucht.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS
ARG TARGETARCH
# Release-Version für die Update-Prüfung; ohne Angabe meldet sich das Binary als „dev“ und gilt nie als veraltet.
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/lodestone-node ./cmd/lodestone-node

FROM alpine:3.24
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/lodestone-node /usr/local/bin/lodestone-node
ENV LODESTONE_NODE_LISTEN=0.0.0.0:8480
EXPOSE 8480
ENTRYPOINT ["lodestone-node"]
